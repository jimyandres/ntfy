# Solo configuración NO secreta. scripts/setup.sh crea .env y guarda los secretos
# (VAPID_PRIVATE_KEY, NOTIFY_TOKEN) en el Llavero de macOS, servicio "ntfy-avisos".
VAPID_PUBLIC_KEY=
# Apple exige mailto: o https:
VAPID_SUBJECT=https://github.com/jeancarlo12/ntfy
PORT=3000
# 127.0.0.1: solo accesible desde este Mac (el túnel se conecta localmente)
BIND=127.0.0.1

# Opcional, watcher de Stratus:
# STRATUS_EVENTS="attention completed failed"
# STRATUS_PREVIEW=0
# STRATUS_NAME_JQ='.title // .name // empty'
